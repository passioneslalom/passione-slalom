---
import "@fontsource/racing-sans-one";
import "@fontsource-variable/inter";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BannerCookie from "../components/BannerCookie.astro";
import { NOME_SITO, DESCRIZIONE_SITO, IMMAGINE_ANTEPRIMA } from "../lib/site";

interface Props {
  titolo: string;
  descrizione?: string;
  /** Tiene la pagina fuori dai motori di ricerca senza toglierla dal sito. */
  noindex?: boolean;
  /** Dati strutturati JSON-LD della pagina (vedi lib/schema.ts). */
  schema?: Record<string, unknown>;
}

const { titolo, descrizione = DESCRIZIONE_SITO, noindex, schema } = Astro.props;
const titoloCompleto = titolo === NOME_SITO ? titolo : `${titolo} — ${NOME_SITO}`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const anteprima = new URL(IMMAGINE_ANTEPRIMA.percorso, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonico} />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOME_SITO} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={anteprima} />
    <meta property="og:image:width" content={String(IMMAGINE_ANTEPRIMA.larghezza)} />
    <meta property="og:image:height" content={String(IMMAGINE_ANTEPRIMA.altezza)} />
    <meta property="og:image:alt" content={IMMAGINE_ANTEPRIMA.alt} />
    {/* Le altre voci X/Twitter le eredita dalle og. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <BannerCookie />

    <style>
      .salta {
        position: absolute;
        left: 0.5rem;
        top: -4rem;
        z-index: 50;
        padding: 0.6rem 1rem;
        background-color: var(--color-yellow);
        color: var(--color-black);
        font-weight: 700;
        text-decoration: none;
        transition: top 0.15s ease;
      }

      .salta:focus {
        top: 0.5rem;
      }
    </style>
  </body>
</html>
