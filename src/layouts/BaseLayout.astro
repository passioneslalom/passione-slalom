---
import "@fontsource/racing-sans-one";
import "@fontsource-variable/inter";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BannerCookie from "../components/BannerCookie.astro";
import { NOME_SITO, DESCRIZIONE_SITO } from "../lib/site";

interface Props {
  titolo: string;
  descrizione?: string;
}

const { titolo, descrizione = DESCRIZIONE_SITO } = Astro.props;
const titoloCompleto = titolo === NOME_SITO ? titolo : `${titolo} — ${NOME_SITO}`;
const canonico = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonico} />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOME_SITO} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:locale" content="it_IT" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <BannerCookie />

    <style>
      .salta {
        position: absolute;
        left: 0.5rem;
        top: -4rem;
        z-index: 50;
        padding: 0.6rem 1rem;
        background-color: var(--color-yellow);
        color: var(--color-black);
        font-weight: 700;
        text-decoration: none;
        transition: top 0.15s ease;
      }

      .salta:focus {
        top: 0.5rem;
      }
    </style>
  </body>
</html>
