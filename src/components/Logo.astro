---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import { NOME_SITO } from "../lib/site";

interface Props {
  /** header: marchio nella barra di navigazione. hero: marchio grande in homepage. */
  variante: "header" | "hero";
}

const { variante } = Astro.props;

/** Larghezza di resa in CSS px: deve combaciare con il CSS in fondo al file.
    header: il CSS fissa l'altezza (2.75rem = 44px), quindi la larghezza scende
    dal rapporto del file — 44 × 1254/665 ≈ 83. hero: la fissa il CSS a 26rem. */
const LARGHEZZE = { header: 83, hero: 416 } as const;

const larghezza = LARGHEZZE[variante];
const altezza = Math.round((larghezza * logo.height) / logo.width);

// Il 2x si genera solo se il sorgente lo regge davvero: senza questo controllo
// Astro produrrebbe un upscale, più pesante da scaricare e non più nitido.
const densita = logo.width >= larghezza * 2 ? [1, 2] : [1];
---

<Image
  src={logo}
  alt={NOME_SITO}
  width={larghezza}
  height={altezza}
  densities={densita}
  class:list={[`logo--${variante}`]}
  loading="eager"
  fetchpriority={variante === "hero" ? "high" : "auto"}
/>

<style>
  /* Il logo è sempre above-the-fold: le misure stanno qui accanto alle
     larghezze usate per generare le varianti, così restano allineate. */

  .logo--header {
    height: 2.75rem;
    width: auto;
  }

  .logo--hero {
    width: min(100%, 26rem);
    height: auto;
    /* drop-shadow e non box-shadow: segue il canale alfa, quindi l'ombra prende
       la sagoma del marchio e non il rettangolo dell'immagine. Due passaggi:
       il primo, corto, tiene il logo agganciato allo sfondo; il secondo, largo
       e diffuso, gli dà lo stacco. Il disegno ha già un contorno nero suo, per
       questo il primo resta molto tenue. */
    filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--color-black) 40%, transparent))
      drop-shadow(0 10px 18px color-mix(in srgb, var(--color-black) 50%, transparent));
  }
</style>
