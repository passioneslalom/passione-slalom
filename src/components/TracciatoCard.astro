---
import type { CollectionEntry } from "astro:content";
import IconaGioco from "./IconaGioco.astro";
import { GIOCHI } from "../lib/giochi";

interface Props {
  tracciato: CollectionEntry<"tracciati">;
  /** Mostra il badge del gioco: serve solo fuori dalle pagine dedicate a un gioco. */
  mostraGioco?: boolean;
}

const { tracciato, mostraGioco = false } = Astro.props;
const { titolo, foto, video, gioco } = tracciato.data;
---

<article class="card">
  <div class="card__foto">
    <img src={foto} alt={`Tracciato ${titolo}`} width="640" height="360" loading="lazy" decoding="async" />
  </div>

  <div class="card__corpo">
    {
      mostraGioco && (
        <p class="badge">
          <IconaGioco gioco={gioco} />
          {GIOCHI[gioco].nome}
        </p>
      )
    }

    <h3 class="card__titolo">{titolo}</h3>

    <a class="card__link" href={video} target="_blank" rel="noopener noreferrer">
      Guarda il video
      <span class="card__freccia" aria-hidden="true">↗</span>
      <span class="visually-hidden">(si apre in una nuova scheda)</span>
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 2px solid var(--bordo);
    border-radius: var(--raggio);
    background-color: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-red);
    transform: translateY(-3px);
  }

  .card__foto {
    aspect-ratio: 16 / 9;
    background-color: var(--surface-alta);
    border-bottom: 2px solid var(--color-red);
  }

  .card__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__corpo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1rem;
    flex: 1;
  }

  .card__titolo {
    font-size: 1.35rem;
    color: var(--color-ivory);
  }

  .card__link {
    margin-top: auto;
    padding-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-yellow);
  }

  /* L'intera card è cliccabile, ma nel DOM resta un solo link. */
  .card__link::before {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link,
  .card__link:focus-visible {
    color: var(--color-red);
  }

  .card__freccia {
    transition: transform 0.16s ease;
  }

  .card:hover .card__freccia {
    transform: translate(2px, -2px);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
