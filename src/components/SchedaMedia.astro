---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import IconaGioco from "./IconaGioco.astro";
import { GIOCHI } from "../lib/giochi";

/**
 * Card foto + titolo + link al video, usata sia dai tracciati che dalle auto:
 * le due collection hanno gli stessi campi e devono restare identiche a vedersi.
 */
interface Props {
  voce: CollectionEntry<"tracciati" | "auto">;
  /** Mostra il badge del gioco: serve solo fuori dalle pagine dedicate a un gioco. */
  mostraGioco?: boolean;
}

/** L'alt non può essere il solo titolo: dice anche di che tipo di foto si tratta. */
const PREFISSO_ALT = {
  tracciati: "Tracciato",
  auto: "Auto",
} as const;

const { voce, mostraGioco = false } = Astro.props;
const { titolo, foto, video, gioco } = voce.data;
const alt = `${PREFISSO_ALT[voce.collection]} ${titolo}`;

// La card segue le colonne di `.griglia-card` (contenitore 72rem, padding 1.25rem,
// gap 1.25rem, colonne da almeno 17rem): 3 colonne sopra 56rem, 2 sopra 38rem,
// altrimenti una sola larga quanto il contenitore. La colonna singola arriva a
// ~564px, quindi molto più dei 368px del desktop: senza `sizes` il browser non
// saprebbe che sotto le 38rem serve un file più grande, non più piccolo.
const SIZES = [
  "(min-width: 72rem) 368px",
  "(min-width: 56rem) calc((100vw - 5rem) / 3)",
  "(min-width: 38rem) calc((100vw - 3.75rem) / 2)",
  "calc(100vw - 2.5rem)",
].join(", ");
---

<article class="card">
  <div class="card__foto">
    {/* Le foto hanno rapporti diversi (16:9, 3:2, 21:9), quindi il ritaglio 16:9
        resta fatto in build: `width`/`height` fissano il rapporto e Astro lo
        riporta su ogni variante di `widths`, così il browser non deve mai
        ingrandire per coprire il riquadro. */}
    <Image
      src={foto}
      alt={alt}
      width={368}
      height={207}
      fit="cover"
      widths={[368, 560, 736, 1120]}
      sizes={SIZES}
      quality={82}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="card__corpo">
    {
      mostraGioco && (
        <p class="badge">
          <IconaGioco gioco={gioco} />
          {GIOCHI[gioco].nome}
        </p>
      )
    }

    <h2 class="card__titolo">{titolo}</h2>

    <a class="card__link" href={video} target="_blank" rel="noopener noreferrer">
      Guarda il video
      <span class="card__freccia" aria-hidden="true">↗</span>
      <span class="visually-hidden">(si apre in una nuova scheda)</span>
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 2px solid var(--bordo);
    border-radius: var(--raggio);
    background-color: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-red);
    transform: translateY(-3px);
  }

  .card__foto {
    aspect-ratio: 16 / 9;
    background-color: var(--surface-alta);
  }

  .card__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__corpo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1rem;
    flex: 1;
  }

  .card__titolo {
    font-size: 1.35rem;
    color: var(--color-ivory);
  }

  .card__link {
    margin-top: auto;
    padding-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-yellow);
  }

  /* L'intera card è cliccabile, ma nel DOM resta un solo link. */
  .card__link::before {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link,
  .card__link:focus-visible {
    color: var(--color-red);
  }

  .card__freccia {
    transition: transform 0.16s ease;
  }

  .card:hover .card__freccia {
    transform: translate(2px, -2px);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
