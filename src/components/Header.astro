---
import Logo from "./Logo.astro";
import { ELENCO_GIOCHI } from "../lib/giochi";

// Normalizza lo slash finale così il confronto funziona con qualsiasi trailingSlash.
const percorso = Astro.url.pathname.replace(/\/?$/, "/");
/** Pagina esattamente aperta: unica voce che riceve aria-current. */
const corrente = (href: string) => (percorso === href ? "page" : undefined);
/** Sezione che contiene la pagina aperta: serve solo all'evidenziazione visiva. */
const nellaSezione = (href: string) => percorso.startsWith(href) || undefined;
---

<header class="testata">
  <div class="contenitore testata__barra">
    <a class="marchio" href="/">
      <Logo variante="header" />
    </a>

    <button
      class="hamburger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="menu-principale"
      data-menu-toggle
    >
      <span class="hamburger__linee" aria-hidden="true"></span>
    </button>

    <nav class="nav" id="menu-principale" aria-label="Navigazione principale" data-menu>
      {/* Involucro senza padding: è lui l'elemento della griglia che si comprime
          a zero, perché un elemento con padding non può scendere sotto di esso. */}
      <div class="nav__involucro">
        <ul class="nav__lista" role="list">
          <li>
            <a class="nav__link" href="/" aria-current={corrente("/")}>Home</a>
          </li>

          <li class="nav__voce-con-sub" data-sub>
            <button
              class="nav__link nav__link--tendina"
              type="button"
              aria-expanded="false"
              aria-controls="menu-gaming"
              data-sezione-attiva={nellaSezione("/gaming/")}
              data-sub-toggle
            >
              Gaming
              <svg
                class="nav__freccia"
                viewBox="0 0 12 8"
                width="12"
                height="8"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
            </button>
            <ul class="sub" id="menu-gaming" role="list">
              {
                ELENCO_GIOCHI.map((gioco) => (
                  <li>
                    <a
                      class="nav__link nav__link--sub"
                      href={gioco.href}
                      aria-current={corrente(gioco.href)}
                      data-sezione-attiva={nellaSezione(`/gaming/${gioco.slug}/`)}
                    >
                      {gioco.nome}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>

          <li>
            <a class="nav__link" href="/galleria/" aria-current={corrente("/galleria/")}>Galleria</a>
          </li>
          <li>
            <a class="nav__link" href="/staff/" aria-current={corrente("/staff/")}>Staff</a>
          </li>
          <li>
            <a class="nav__link" href="/chi-siamo/" aria-current={corrente("/chi-siamo/")}>
              Chi Siamo
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  toggle?.addEventListener("click", () => {
    const aperto = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!aperto));
    menu?.toggleAttribute("data-aperto", !aperto);
  });

  // Tendina "Gaming": su desktop si apre anche in hover/focus (CSS), qui gestiamo il click.
  const voceSub = document.querySelector<HTMLElement>("[data-sub]");
  const subToggle = voceSub?.querySelector<HTMLButtonElement>("[data-sub-toggle]");

  const chiudiSub = () => {
    subToggle?.setAttribute("aria-expanded", "false");
    voceSub?.removeAttribute("data-aperto");
  };

  subToggle?.addEventListener("click", () => {
    const aperto = subToggle.getAttribute("aria-expanded") === "true";
    subToggle.setAttribute("aria-expanded", String(!aperto));
    voceSub?.toggleAttribute("data-aperto", !aperto);
  });

  document.addEventListener("click", (evento) => {
    if (voceSub && !voceSub.contains(evento.target as Node)) chiudiSub();
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key !== "Escape") return;
    if (voceSub?.contains(document.activeElement)) subToggle?.focus();
    chiudiSub();
  });
</script>

<style>
  .testata {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--color-black);
    border-bottom: 3px solid var(--color-red);
  }

  .testata__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Su mobile il menu va a capo come riga della barra: a menu chiuso ha altezza
       zero, quindi un row-gap lascerebbe un vuoto sotto la testata. Lo spazio
       sopra la prima voce lo mette il padding di .nav__lista. */
    column-gap: 1rem;
    row-gap: 0;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }

  .marchio {
    display: block;
    line-height: 0;
  }

  /* ---------- hamburger (solo mobile) ---------- */

  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Nessun bordo né etichetta: il quadrato serve solo come area di tocco. */
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background-color: transparent;
    color: var(--color-ivory);
    cursor: pointer;
  }

  .hamburger__linee,
  .hamburger__linee::before,
  .hamburger__linee::after {
    display: block;
    width: 1.35rem;
    height: 2px;
    background-color: currentColor;
    transition:
      transform 0.25s ease,
      background-color 0.2s ease;
  }

  .hamburger__linee {
    position: relative;
  }

  .hamburger__linee::before,
  .hamburger__linee::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .hamburger__linee::before {
    top: -6px;
  }

  .hamburger__linee::after {
    top: 6px;
  }

  /* Aperto: la linea centrale svanisce, le altre due convergono e si incrociano. */
  .hamburger[aria-expanded="true"] .hamburger__linee {
    background-color: transparent;
  }

  .hamburger[aria-expanded="true"] .hamburger__linee::before {
    transform: translateY(6px) rotate(45deg);
  }

  .hamburger[aria-expanded="true"] .hamburger__linee::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger__linee,
    .hamburger__linee::before,
    .hamburger__linee::after {
      transition: none;
    }
  }

  /* ---------- navigazione ---------- */

  /* Apertura animata senza JS: `display` non è interpolabile, la riga della
     griglia sì. Da 0fr a 1fr l'altezza di arrivo è quella vera del contenuto,
     senza un max-height indovinato che spezzerebbe l'andamento dell'easing.
     `visibility` sostituisce il vecchio `display: none`: toglie il menu chiuso
     dall'ordine di tabulazione, e transitandola resta visibile finché la riga
     non ha finito di richiudersi. */
  .nav {
    display: grid;
    grid-template-rows: 0fr;
    width: 100%;
    visibility: hidden;
    /* La testata è sticky: su schermi bassi il menu deve poter scorrere da solo. */
    max-height: calc(100vh - 6rem);
    transition:
      grid-template-rows 0.28s ease,
      visibility 0.28s;
  }

  .nav[data-aperto] {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  /* Elemento della griglia: deve essere nudo. Con `box-sizing: border-box`
     l'altezza usata non scende mai sotto padding e bordo, quindi il padding
     della lista qui impedirebbe alla riga di richiudersi fino a zero. */
  .nav__involucro {
    min-height: 0;
    overflow: hidden;
  }

  .nav[data-aperto] .nav__involucro {
    overflow-y: auto;
  }

  .nav__lista {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    /* 1.5rem in cima: 0.5rem suoi più il rem che prima veniva dal gap della barra. */
    padding: 1.5rem 0 0.75rem;
    list-style: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.5rem;
    border: 0;
    border-left: 3px solid transparent;
    color: var(--color-ivory);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav__link:hover,
  .nav__link[aria-current="page"],
  .nav__link[data-sezione-attiva] {
    border-left-color: var(--color-red);
    color: var(--color-yellow);
  }

  .nav__link--sub {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--testo-attenuato);
  }

  /* Voce che apre la tendina: è un <button>, va riportato all'aspetto dei link. */
  .nav__link--tendina {
    width: 100%;
    background-color: transparent;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .nav__freccia {
    flex: none;
    margin-left: auto;
    transition: transform 0.15s ease;
  }

  .nav__voce-con-sub[data-aperto] .nav__freccia {
    transform: rotate(180deg);
  }

  .sub {
    display: none;
    list-style: none;
    padding-left: 1.6rem;
  }

  .nav__voce-con-sub[data-aperto] .sub {
    display: block;
  }

  @media (min-width: 62rem) {
    .hamburger {
      display: none;
    }

    .nav,
    .nav[data-aperto] {
      display: block;
      width: auto;
      max-height: none;
      overflow: visible;
      visibility: visible;
      transition: none;
    }

    /* Il sottomenu è in position:absolute: qui non va ritagliato. */
    .nav__involucro {
      overflow: visible;
    }

    .nav__lista {
      flex-direction: row;
      align-items: center;
      gap: 0.25rem;
      padding: 0;
    }

    .nav__link {
      padding: 0.5rem 0.7rem;
      border-left: none;
      border-bottom: 3px solid transparent;
    }

    .nav__link:hover,
    .nav__link[aria-current="page"],
    .nav__link[data-sezione-attiva] {
      border-left-color: transparent;
      border-bottom-color: var(--color-red);
    }

    /* Sottomenu a tendina: apertura in hover e in focus da tastiera. */
    .nav__voce-con-sub {
      position: relative;
    }

    .nav__link--tendina {
      width: auto;
    }

    .nav__freccia {
      margin-left: 0;
    }

    .sub,
    .nav__voce-con-sub[data-aperto] .sub {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 13rem;
      padding: 0.35rem 0;
      border: 2px solid var(--color-red);
      border-radius: var(--raggio);
      background-color: var(--color-black);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.12s ease,
        visibility 0.12s ease;
    }

    .nav__voce-con-sub:hover .sub,
    .nav__voce-con-sub:focus-within .sub,
    .nav__voce-con-sub[data-aperto] .sub {
      visibility: visible;
      opacity: 1;
    }

    .nav__voce-con-sub:hover .nav__freccia,
    .nav__voce-con-sub:focus-within .nav__freccia {
      transform: rotate(180deg);
    }

    .nav__link--sub {
      border-bottom: none;
      border-left: 3px solid transparent;
      white-space: nowrap;
    }

    .nav__link--sub:hover,
    .nav__link--sub[aria-current="page"] {
      border-bottom-color: transparent;
      border-left-color: var(--color-red);
    }
  }
</style>
