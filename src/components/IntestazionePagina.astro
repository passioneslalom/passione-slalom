---
/** Testata comune a tutte le pagine interne: occhiello, titolo e riga di contesto. */
interface Props {
  occhiello?: string;
  titolo: string;
  intro?: string;
}

const { occhiello, titolo, intro } = Astro.props;
---

<div class="intestazione">
  <div class="contenitore">
    {occhiello && <p class="occhiello">{occhiello}</p>}
    <h1>{titolo}</h1>
    {intro && <p class="intestazione__intro">{intro}</p>}
  </div>
</div>

<style>
  .intestazione {
    padding-block: clamp(2rem, 6vw, 3.5rem);
    background-color: var(--surface);
    border-bottom: 1px solid var(--bordo);
  }

  .intestazione h1 {
    margin-top: 0.35rem;
  }

  .intestazione__intro {
    max-width: 60ch;
    margin-top: 0.9rem;
    color: var(--testo-attenuato);
  }
</style>
