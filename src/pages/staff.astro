---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import IntestazionePagina from "../components/IntestazionePagina.astro";
import StaffCard from "../components/StaffCard.astro";

const staff = (await getCollection("staff")).sort((a, b) => {
  const ordineA = a.data.ordine ?? Number.MAX_SAFE_INTEGER;
  const ordineB = b.data.ordine ?? Number.MAX_SAFE_INTEGER;
  if (ordineA !== ordineB) return ordineA - ordineB;
  return a.data.nome.localeCompare(b.data.nome, "it");
});
---

<BaseLayout
  titolo="Staff"
  descrizione="Chi manda avanti Passione Slalom: organizzazione, direzione gara e gestione dei tracciati."
>
  <IntestazionePagina
    occhiello="La squadra"
    titolo="Staff"
    intro="Le persone che organizzano le gare, preparano i tracciati e tengono in piedi il Discord."
  />

  <section class="sezione">
    <div class="contenitore">
      {
        staff.length > 0 ? (
          <ul class="griglia-card" role="list">
            {staff.map((membro) => (
              <li>
                <StaffCard membro={membro} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="testo-lungo">Nessun membro dello staff pubblicato al momento.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
