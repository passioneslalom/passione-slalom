---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CheckeredDivider from "../components/CheckeredDivider.astro";
import FasciaHero from "../components/FasciaHero.astro";
import Logo from "../components/Logo.astro";
import Bottone from "../components/Bottone.astro";
import GrigliaFoto from "../components/GrigliaFoto.astro";
import IconaSocial from "../components/IconaSocial.astro";
import { PERCORSI_SOCIAL } from "../lib/social-icons";
import { getFotoInEvidenza } from "../lib/galleria";
import { getPartners } from "../lib/partners";
import { SOCIAL, DISCORD_URL, NOME_SITO, DESCRIZIONE_SITO } from "../lib/site";

const fotoInEvidenza = await getFotoInEvidenza();
const partners = await getPartners();
---

<BaseLayout titolo={NOME_SITO}>
  <!-- Hero -->
  <FasciaHero claim={DESCRIZIONE_SITO}>
    <Logo variante="hero" slot="marchio" />
    <Bottone slot="azione" href={DISCORD_URL} esterno grande>Entra nel nostro Discord</Bottone>
  </FasciaHero>

  <CheckeredDivider />

  <!-- Galleria -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Foto, video e interviste</p>
      <h2 class="titolo-sezione">Le migliori foto</h2>
      <GrigliaFoto foto={fotoInEvidenza} ritmo />
      <p class="azione-sezione">
        <Bottone href="/galleria/">Esplora la galleria</Bottone>
      </p>
    </div>
  </section>

  <CheckeredDivider />

  <!-- Social -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Seguici</p>
      <h2 class="titolo-sezione">Dove ci trovi</h2>
      <ul class="social" role="list">
        {
          SOCIAL.map(({ social, url }) => (
            <li>
              <a class="social__link" href={url} target="_blank" rel="noopener noreferrer">
                <IconaSocial social={social} />
                <span>{PERCORSI_SOCIAL[social].nome}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CheckeredDivider />

  <!-- Partners -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Con il supporto di</p>
      <h2 class="titolo-sezione">Partners</h2>
      <ul class="partners" role="list">
        {
          partners.map((p) => {
            // Il sito è facoltativo: senza, la cella resta un contenitore muto
            // invece di un link vuoto che finirebbe comunque nella navigazione
            // da tastiera.
            const Cella = p.sito ? "a" : "div";
            const attributi = p.sito
              ? { href: p.sito, target: "_blank", rel: "noopener noreferrer" }
              : {};
            return (
              <li>
                <Cella class="partners__cella" {...attributi}>
                  <Image
                    src={p.logo}
                    alt={p.nome}
                    width={640}
                    widths={[320, 640]}
                    sizes="(min-width: 62rem) 320px, (min-width: 30rem) 25vw, 90vw"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                </Cella>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* La hero vive in FasciaHero.astro, condivisa con la pagina campionati. */

  /* ---------- galleria ---------- */

  /* La griglia vive in GrigliaFoto.astro: qui resta solo il richiamo alla pagina. */
  .azione-sezione {
    margin-top: 1.5rem;
    text-align: center;
  }

  /* ---------- social ---------- */

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .social__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.1rem;
    border: 2px solid var(--bordo);
    border-radius: var(--raggio);
    color: var(--color-ivory);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .social__link:hover,
  .social__link:focus-visible {
    background-color: var(--color-red);
    border-color: var(--color-red);
    color: var(--color-yellow);
  }

  /* ---------- partners ---------- */

  .partners {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    margin-top: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .partners__cella {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Gabbia comune: i loghi vanno da 1.92 a 0.98 di rapporto, senza un box
       uniforme le celle della stessa riga avrebbero altezze diverse. */
    aspect-ratio: 3 / 2;
    padding: 0.75rem;
    border: 2px solid var(--bordo);
    border-radius: var(--raggio);
    background-color: var(--surface);
    text-decoration: none;
  }

  /* Solo le celle con un sito sono link: il bordo che si accende è l'unico
     segnale che quella è cliccabile e le altre no. */
  a.partners__cella {
    transition: border-color 0.16s ease;
  }

  a.partners__cella:hover,
  a.partners__cella:focus-visible {
    border-color: var(--color-red);
  }

  .partners__cella img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Su desktop tre per riga invece di sei: i loghi raddoppiano abbondantemente. */
  @media (min-width: 62rem) {
    .partners {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .partners__cella {
      padding: 1.5rem;
    }
  }
</style>
