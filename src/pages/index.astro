---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CheckeredDivider from "../components/CheckeredDivider.astro";
import Logo from "../components/Logo.astro";
import Bottone from "../components/Bottone.astro";
import GrigliaFoto from "../components/GrigliaFoto.astro";
import IconaSocial from "../components/IconaSocial.astro";
import { PERCORSI_SOCIAL } from "../lib/social-icons";
import { FOTO_IN_EVIDENZA } from "../lib/galleria";
import { SPONSOR } from "../lib/sponsor";
import { SOCIAL, DISCORD_URL, NOME_SITO, DESCRIZIONE_SITO } from "../lib/site";
---

<BaseLayout titolo={NOME_SITO}>
  <!-- Hero -->
  <section class="hero">
    <div class="contenitore hero__contenuto">
      <Logo variante="hero" />
      <p class="hero__claim">{DESCRIZIONE_SITO}</p>
      <Bottone href={DISCORD_URL} esterno grande>Entra nel nostro Discord</Bottone>
    </div>
  </section>

  <CheckeredDivider />

  <!-- Galleria -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Dai nostri eventi</p>
      <h2 class="titolo-sezione">In pista con noi</h2>
      <GrigliaFoto foto={FOTO_IN_EVIDENZA} ritmo />
      <p class="azione-sezione">
        <Bottone href="/galleria/">Esplora la galleria</Bottone>
      </p>
    </div>
  </section>

  <CheckeredDivider />

  <!-- Social -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Seguici</p>
      <h2 class="titolo-sezione">Dove ci trovi</h2>
      <ul class="social" role="list">
        {
          SOCIAL.map(({ social, url }) => (
            <li>
              <a class="social__link" href={url} target="_blank" rel="noopener noreferrer">
                <IconaSocial social={social} />
                <span>{PERCORSI_SOCIAL[social].nome}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CheckeredDivider />

  <!-- Sponsor -->
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">Con il supporto di</p>
      <h2 class="titolo-sezione">Sponsor</h2>
      <ul class="sponsor" role="list">
        {
          SPONSOR.map((s) => (
            <li class="sponsor__cella">
              <Image
                src={s.logo}
                alt={s.nome}
                width={640}
                widths={[320, 640]}
                sizes="(min-width: 62rem) 320px, (min-width: 30rem) 25vw, 90vw"
                quality={80}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */

  .hero {
    padding-block: clamp(2.5rem, 9vw, 5.5rem);
    background-color: var(--surface);
    background-image: var(--fascia-vignettata);
    border-bottom: 1px solid var(--bordo);
  }

  .hero__contenuto {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .hero__claim {
    max-width: 44ch;
    font-size: clamp(1rem, 2.6vw, 1.2rem);
    color: var(--testo-attenuato);
  }

  /* ---------- galleria ---------- */

  /* La griglia vive in GrigliaFoto.astro: qui resta solo il richiamo alla pagina. */
  .azione-sezione {
    margin-top: 1.5rem;
    text-align: center;
  }

  /* ---------- social ---------- */

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .social__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.1rem;
    border: 2px solid var(--bordo);
    border-radius: var(--raggio);
    color: var(--color-ivory);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .social__link:hover,
  .social__link:focus-visible {
    background-color: var(--color-red);
    border-color: var(--color-red);
    color: var(--color-yellow);
  }

  /* ---------- sponsor ---------- */

  .sponsor {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    margin-top: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .sponsor__cella {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Gabbia comune: i loghi vanno da 1.92 a 0.98 di rapporto, senza un box
       uniforme le celle della stessa riga avrebbero altezze diverse. */
    aspect-ratio: 3 / 2;
    padding: 0.75rem;
    border: 2px solid var(--bordo);
    border-radius: var(--raggio);
    background-color: var(--surface);
  }

  .sponsor__cella img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Su desktop tre per riga invece di sei: i loghi raddoppiano abbondantemente. */
  @media (min-width: 62rem) {
    .sponsor {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .sponsor__cella {
      padding: 1.5rem;
    }
  }
</style>
