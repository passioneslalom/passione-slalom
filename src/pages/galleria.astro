---
import BaseLayout from "../layouts/BaseLayout.astro";
import IntestazionePagina from "../components/IntestazionePagina.astro";
import GrigliaFoto from "../components/GrigliaFoto.astro";
import { getFoto } from "../lib/galleria";

const foto = await getFoto();
---

<BaseLayout
  titolo="Galleria"
  descrizione="Le foto delle gare, dei paddock e delle premiazioni di Passione Slalom."
>
  <IntestazionePagina
    occhiello="Dai nostri eventi"
    titolo="Galleria"
    intro="Una collezione delle nostre migliori foto."
  />

  <section class="sezione">
    <div class="contenitore">
      {
        foto.length > 0 ? (
          <GrigliaFoto foto={foto} />
        ) : (
          <p class="testo-lungo">Nessuna foto pubblicata al momento.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
