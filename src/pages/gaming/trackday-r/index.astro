---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import SezioniGioco, { type Sezione } from "../../../components/SezioniGioco.astro";
import { GIOCHI } from "../../../lib/giochi";

const gioco = GIOCHI["trackday-r"];

// Per ora l'unica sezione attiva: la pagina esiste comunque, così la struttura
// del menu è la stessa per tutti i giochi e c'è dove aggiungere le prossime.
const SEZIONI: Sezione[] = [
  {
    nome: "Tracciati",
    href: "/gaming/trackday-r/tracciati/",
    descrizione: "Tracciati creati da zero dai nostri modders.",
  },
];
---

<BaseLayout
  titolo={gioco.nome}
  descrizione={`Quello che Passione Slalom pubblica su ${gioco.nome}: per ora i tracciati slalom creati da zero dai nostri modders.`}
>
  <IntestazionePagina
    occhiello="Gaming"
    titolo={gioco.nome}
    intro="Quello che pubblichiamo su TrackDay R. Al momento trovi i tracciati; le altre sezioni si aggiungeranno qui."
  />

  <section class="sezione">
    <div class="contenitore">
      <SezioniGioco sezioni={SEZIONI} />
    </div>
  </section>
</BaseLayout>
