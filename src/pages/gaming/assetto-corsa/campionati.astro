---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import Bottone from "../../../components/Bottone.astro";
import { GIOCHI } from "../../../lib/giochi";
import { DISCORD_URL } from "../../../lib/site";

const gioco = GIOCHI["assetto-corsa"];

// I campionati non si gestiscono da qui: calendario, iscrizioni e regolamento
// vivono sul Discord. La pagina serve solo ad arrivarci, quindi niente regole
// duplicate che poi resterebbero indietro rispetto al server.
const PASSI = [
  {
    titolo: "Entra nel Discord",
    testo: "È il punto di ritrovo della community: mod esclusive per gli iscritti e server sempre aperti.",
  },
  {
    titolo: "Apri il canale annunci",
    testo: "Lì vengono pubblicate le tappe in programma e le iscrizioni aperte.",
  },
  {
    titolo: "Scendi in pista",
    testo: "Si corre nelle serate in calendario, con le live e i premi in palio.",
  },
];
---

<BaseLayout
  titolo="Campionati Assetto Corsa"
  descrizione="Mod esclusive, premi in palio, live e server sempre aperti: i campionati slalom di Passione Slalom su Assetto Corsa si organizzano sul Discord."
>
  <IntestazionePagina
    occhiello={gioco.nome}
    occhielloHref={gioco.href}
    titolo="Campionati"
    intro="Mod esclusive per gli iscritti ai campionati, premi in palio, live, server sempre aperti."
  />

  <section class="sezione">
    <div class="contenitore">
      <ol class="passi" role="list">
        {
          PASSI.map((passo, indice) => (
            <li class="passo">
              <span class="passo__numero" aria-hidden="true">
                {indice + 1}
              </span>
              <h2 class="passo__titolo">{passo.titolo}</h2>
              <p class="passo__testo">{passo.testo}</p>
            </li>
          ))
        }
      </ol>

      <p class="azione">
        <Bottone href={DISCORD_URL} esterno grande>Entra nel nostro Discord</Bottone>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .passi {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .passo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .passo__numero {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    color: var(--color-red);
  }

  .passo__titolo {
    font-size: 1.25rem;
    color: var(--color-ivory);
  }

  .passo__testo {
    font-size: 0.95rem;
    color: var(--testo-attenuato);
  }

  /* Stacco più largo del passo fra le colonne: il bottone chiude la pagina e
     non deve sembrare la quarta voce dell'elenco. */
  .azione {
    margin-top: clamp(2.25rem, 6vw, 3.25rem);
    text-align: center;
  }
</style>
