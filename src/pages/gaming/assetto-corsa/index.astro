---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import SezioniGioco, { type Sezione } from "../../../components/SezioniGioco.astro";
import { GIOCHI } from "../../../lib/giochi";

const gioco = GIOCHI["assetto-corsa"];

const SEZIONI: Sezione[] = [
  {
    nome: "Tracciati",
    href: "/gaming/assetto-corsa/tracciati/",
    descrizione: "Tracciati creati da zero dai nostri modders.",
  },
  {
    nome: "Auto",
    href: "/gaming/assetto-corsa/auto/",
    descrizione: "Vetture realizzate con fisiche sviluppate con meccanici e piloti reali.",
  },
  {
    nome: "Campionati",
    href: "/gaming/assetto-corsa/campionati/",
    descrizione: "Mod esclusive per gli iscritti ai campionati, premi in palio, live, server sempre aperti.",
  },
  {
    nome: "Crediti Carriera Passione Slalom",
    href: "/gaming/assetto-corsa/crediti-carriera/",
    descrizione: "Accedi ad auto di categorie sempre più alte ed esclusivi campionati.",
  },
];
---

<BaseLayout
  titolo={gioco.nome}
  descrizione="Tracciati, auto, campionati e crediti carriera di Passione Slalom su Assetto Corsa."
>
  <IntestazionePagina
    occhiello="Gaming"
    titolo={gioco.nome}
    intro="Il gioco su cui gira la maggior parte della nostra attività. Da qui accedi a tracciati, vetture, campionati e regolamento."
  />

  <section class="sezione">
    <div class="contenitore">
      <SezioniGioco sezioni={SEZIONI} />
    </div>
  </section>
</BaseLayout>
