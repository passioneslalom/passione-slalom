---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import SezioniGioco, { type Sezione } from "../../../components/SezioniGioco.astro";
import { GIOCHI } from "../../../lib/giochi";

const gioco = GIOCHI["assetto-corsa"];

const SEZIONI: Sezione[] = [
  {
    nome: "Tracciati",
    href: "/gaming/assetto-corsa/tracciati/",
    descrizione: "Tutti i percorsi della community, con foto e video onboard.",
  },
  {
    nome: "Auto",
    href: "/gaming/assetto-corsa/auto/",
    descrizione: "Le vetture utilizzate nelle nostre gare, divise per categoria.",
  },
  {
    nome: "Campionati",
    href: "/gaming/assetto-corsa/campionati/",
    descrizione: "Calendario, format delle gare e regolamento sportivo.",
  },
  {
    nome: "Punti & Crediti",
    href: "/gaming/assetto-corsa/punti-crediti/",
    descrizione: "Come si assegnano i punti in classifica e come funzionano i crediti.",
  },
];
---

<BaseLayout
  titolo={gioco.nome}
  descrizione="Tracciati, auto, campionati e regolamento punti di Passione Slalom su Assetto Corsa."
>
  <IntestazionePagina
    occhiello="Gaming"
    titolo={gioco.nome}
    intro="Il gioco su cui gira la maggior parte della nostra attività. Da qui accedi a tracciati, vetture, campionati e regolamento."
  />

  <section class="sezione">
    <div class="contenitore">
      <SezioniGioco sezioni={SEZIONI} />
    </div>
  </section>
</BaseLayout>
