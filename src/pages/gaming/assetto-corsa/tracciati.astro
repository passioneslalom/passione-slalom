---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import SchedaMedia from "../../../components/SchedaMedia.astro";
import { getTracciati } from "../../../lib/contenuti-gioco";
import { GIOCHI } from "../../../lib/giochi";

const gioco = GIOCHI["assetto-corsa"];
const tracciati = await getTracciati(gioco.slug);
---

<BaseLayout
  titolo={`Tracciati ${gioco.nome}`}
  descrizione={`Tracciati slalom creati da zero dai modder di Passione Slalom per ${gioco.nome}, ognuno con il suo video onboard.`}
>
  <IntestazionePagina
    occhiello={gioco.nome}
    occhielloHref={gioco.href}
    titolo={`Tracciati ${gioco.nome}`}
    intro="Tracciati creati da zero dai nostri modders."
  />

  <section class="sezione">
    <div class="contenitore">
      {
        tracciati.length > 0 ? (
          <ul class="griglia-card" role="list">
            {tracciati.map((tracciato) => (
              <li>
                <SchedaMedia voce={tracciato} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="testo-lungo">Nessun tracciato pubblicato per il momento.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
