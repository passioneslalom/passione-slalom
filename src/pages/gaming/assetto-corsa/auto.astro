---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import SchedaMedia from "../../../components/SchedaMedia.astro";
import { getAuto } from "../../../lib/contenuti-gioco";
import { GIOCHI } from "../../../lib/giochi";

const gioco = GIOCHI["assetto-corsa"];
const auto = await getAuto(gioco.slug);
---

<BaseLayout
  titolo={`Auto ${gioco.nome}`}
  descrizione={`Le vetture usate nelle gare slalom della community Passione Slalom su ${gioco.nome}.`}
>
  <IntestazionePagina
    occhiello={gioco.nome}
    occhielloHref={gioco.href}
    titolo="Auto"
    intro="Le vetture che usiamo nelle gare e negli allenamenti. Ogni auto ha un video di riferimento."
  />

  <section class="sezione">
    <div class="contenitore">
      {
        auto.length > 0 ? (
          <ul class="griglia-card" role="list">
            {auto.map((vettura) => (
              <li>
                <SchedaMedia voce={vettura} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="testo-lungo">Nessuna auto pubblicata per il momento.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
