---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import Bottone from "../../../components/Bottone.astro";
import { DISCORD_URL } from "../../../lib/site";

// Sezione in arrivo: quando ci saranno i contenuti diventerà una collection
// analoga a `tracciati` (vedi src/content.config.ts) con la sua card dedicata.
---

<BaseLayout
  titolo="Auto Assetto Corsa"
  descrizione="Le vetture usate nelle gare slalom di Passione Slalom su Assetto Corsa. Sezione in arrivo."
>
  <IntestazionePagina occhiello="Assetto Corsa" titolo="Auto" />

  <section class="sezione">
    <div class="contenitore">
      <div class="avviso">
        <p class="avviso__titolo">Sezione in arrivo</p>
        <p class="avviso__testo">
          Stiamo raccogliendo la lista completa delle vetture con setup di riferimento e
          categoria di appartenenza. Nel frattempo trovi tutto sul Discord, nel canale dedicato
          agli assetti.
        </p>
        <Bottone href={DISCORD_URL} esterno>Chiedi sul Discord</Bottone>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .avviso {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 46rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 2px dashed var(--color-red);
    border-radius: var(--raggio);
    background-color: var(--surface);
  }

  .avviso__titolo {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 1.85rem);
    text-transform: uppercase;
    color: var(--color-yellow);
  }

  .avviso__testo {
    max-width: 58ch;
    color: var(--testo-attenuato);
  }
</style>
