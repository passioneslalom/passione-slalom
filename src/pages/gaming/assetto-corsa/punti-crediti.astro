---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IntestazionePagina from "../../../components/IntestazionePagina.astro";
import CheckeredDivider from "../../../components/CheckeredDivider.astro";

const PUNTI = [
  { posizione: "1º", punti: 25 },
  { posizione: "2º", punti: 18 },
  { posizione: "3º", punti: 15 },
  { posizione: "4º", punti: 12 },
  { posizione: "5º", punti: 10 },
  { posizione: "6º", punti: 8 },
  { posizione: "7º", punti: 6 },
  { posizione: "8º", punti: 4 },
  { posizione: "9º", punti: 2 },
  { posizione: "10º", punti: 1 },
];
---

<BaseLayout
  titolo="Punti & Crediti Assetto Corsa"
  descrizione="Come funzionano punteggi di campionato e crediti nelle gare slalom di Passione Slalom su Assetto Corsa."
>
  <IntestazionePagina
    occhiello="Assetto Corsa"
    titolo="Punti & Crediti"
    intro="Il regolamento con cui assegniamo i punti in classifica e i crediti spendibili nella community."
  />

  <section class="sezione">
    <div class="contenitore testo-lungo">
      <h3>Punti di tappa</h3>
      <p>
        Al termine di ogni tappa i punti vengono assegnati in base alla classifica finale, che
        somma i due tempi migliori di ciascun pilota.
      </p>
    </div>

    <div class="contenitore">
      <table class="tabella">
        <caption class="visually-hidden">Punti assegnati per posizione di arrivo</caption>
        <thead>
          <tr>
            <th scope="col">Posizione</th>
            <th scope="col">Punti</th>
          </tr>
        </thead>
        <tbody>
          {
            PUNTI.map((riga) => (
              <tr>
                <th scope="row">{riga.posizione}</th>
                <td>{riga.punti}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="contenitore testo-lungo">
      <h3>Bonus</h3>
      <ul>
        <li>Miglior tempo assoluto di serata: +2 punti.</li>
        <li>Manche completata senza birilli abbattuti in tutte e tre le manche: +1 punto.</li>
      </ul>

      <h3>Crediti</h3>
      <p>
        Oltre ai punti di classifica, ogni partecipazione assegna crediti: 10 per la presenza a
        una tappa, più un credito per ogni punto conquistato. I crediti non incidono sulla
        classifica sportiva e servono solo all'interno della community.
      </p>
      <p>
        Si spendono per sbloccare livree personalizzate, prenotare il proprio numero di gara per
        la stagione e partecipare alle tappe a invito di fine ciclo. Il saldo è consultabile sul
        Discord.
      </p>

      <h3>Classifica finale</h3>
      <p>
        Vale la somma dei punti di tutte le tappe, scartando il risultato peggiore della stagione.
        A parità di punti conta il numero di vittorie di tappa, poi il miglior piazzamento.
      </p>
    </div>
  </section>

  <CheckeredDivider sottile />
</BaseLayout>

<style>
  .tabella {
    width: 100%;
    max-width: 26rem;
    margin-block: 1.5rem;
    border-collapse: collapse;
    border: 2px solid var(--bordo);
    font-size: 0.95rem;
  }

  .tabella caption {
    text-align: left;
  }

  .tabella th,
  .tabella td {
    padding: 0.55rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--bordo);
  }

  .tabella thead th {
    background-color: var(--color-red);
    color: var(--color-yellow);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tabella tbody th {
    font-weight: 700;
    color: var(--color-ivory);
  }

  .tabella tbody td {
    color: var(--color-yellow);
    font-variant-numeric: tabular-nums;
  }

  .tabella tbody tr:last-child th,
  .tabella tbody tr:last-child td {
    border-bottom: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
